{
  "agents": {
    "defaults": {
      "workspace": "${CG_REPO_ROOT}/examples/nanobot/multihop_agent_handoff_demo/workspace_a"
    }
  },
  "tools": {
    "exec": {
      "pathAppend": "${CG_REPO_ROOT}/.venv/bin",
      "allowedEnvKeys": [
        "CG_BASE_URL",
        "CG_PROJECT_ID",
        "CG_AGENT_CREDENTIAL_TOKEN",
        "CG_AGENT_CREDENTIAL_TOKEN_FILE"
      ]
    }
  },
  "gateway": {
    "cg": {
      "enabled": true,
      "baseUrl": "${CG_BASE_URL}",
      "projectId": "${CG_PROJECT_ID}",
      "agentId": "nanobot_a",
      "authTokenEnv": "CG_AGENT_CREDENTIAL_TOKEN",
      "claimPollIntervalMs": 500,
      "claimHeartbeatIntervalMs": 500,
      "progressMinIntervalMs": 500,
      "contextLimit": 100
    }
  }
}
